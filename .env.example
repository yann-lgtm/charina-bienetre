# Envoi des e-mails (demande de rendez-vous + accusé de réception).
# ⚠️ En V1 l'expéditeur est contact@coeuru.com : c'est le seul domaine vérifié
# chez Resend. À basculer sur le domaine de Charina une fois celui-ci vérifié.
RESEND_API_KEY=

# Destinataire des demandes. Adresse de Charina, éventuellement en copie Yann.
# Sans cette variable, les demandes partent sur MARQUE.emailContact.
EMAIL_NOTIFICATION=

# Notification poussée à chaque demande. Choisir un nom long et non devinable :
# un topic ntfy est public pour qui connaît son nom.
NTFY_TOPIC=
# Facultatif, seulement pour un serveur ntfy auto-hébergé.
NTFY_URL=
